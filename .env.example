# =====================================================
# ARCHIVO: .env.example
# Copia este archivo como ".env" y llena los valores
# NUNCA subas tu .env real a GitHub
# =====================================================

PORT=3001
NODE_ENV=production

# JWT - Genera con: node -e "require('crypto').randomBytes(64).toString('base64') |> console.log"
JWT_SECRET=CAMBIA_ESTO_por_una_clave_de_64_caracteres_aleatoria

# Superadmin - Genera con: node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
SUPER_ADMIN_KEY=CAMBIA_ESTO_por_clave_hex_aleatoria

# CORS - Ponle tu dominio o IP del servidor
# Ejemplo: https://asistencia.mischool.com o http://192.168.1.100:3001
ALLOWED_ORIGINS=http://localhost:3001

# Base de datos PostgreSQL (deja vacío para usar SQLite en local)
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/asistencia_db

# Mercado Pago (opcional - sin esto funciona en modo demo)
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# Twilio SMS (opcional - sin esto no envía SMS)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1...

# Precio de licencia en MXN (default: 99)
# PRECIO_LICENCIA_MXN=99
